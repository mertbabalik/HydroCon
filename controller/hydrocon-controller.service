[Unit]
Description=HydroCon fuzzy logic nutrient controller
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/HydroCon/controller
ExecStart=/home/pi/HydroCon/controller/.venv/bin/python -m hydrocon.main --config config.yaml
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
